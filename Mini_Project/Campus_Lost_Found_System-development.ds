 application "Campus Lost Found System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form claim_requests
		{
			displayname = "Claim Requests"
			success message = "Claim Requests Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			item_type
			(
				type = radiobuttons
				displayname = "Item Type"
				values = {"Found Item","Lost Item"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			item_reference
			(
				type = picklist	
				displayname = "Item Reference"
				values  = lost_items.ID
    			displayformat = [item_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_name
			(
    			type = text
				displayname = "Claimant Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_email
			(
    			type = email
				displayname = "Claimant Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_description
			(
    			type = textarea
				displayname = "Claim Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			additional_details
			(
    			type = textarea
				displayname = "Additional Identification Details"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_status
			(
				type = picklist
				displayname = "Claim Status"
				values = {"Approved","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			admin_remarks
			(
    			type = textarea
				displayname = "Admin Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			submitted_date
			(
    			type = datetime
				displayname = "Submitted Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Claim Under Review","Claim Rejected","Claim Verified","Claim Pending Information","Claim Approved","Claim Closed"}
			}
		}
