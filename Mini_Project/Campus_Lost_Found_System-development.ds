	reports
	{
		list claim_requests_Report
		{
			displayName = "All Claim Requests"
			show all rows from claim_requests    
			(
				item_type as "Item Type"
				item_reference as "Item Reference"
				claimant_name as "Claimant Name"
				claimant_email as "Claimant Email"
				claim_description as "Claim Description"
				additional_details as "Additional Identification Details"
				claim_status as "Claim Status"
				admin_remarks as "Admin Remarks"
				submitted_date as "Submitted Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (claim_status == "Approved")
				fields = [claim_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (claim_status == "Rejected")
				fields = [claim_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban claim_requests_by_claim_status
		{
			displayName = "Claim Statuses"
			show all rows from claim_requests    
			(
				item_type as "Item Type"
				item_reference as "Item Reference"
				claimant_name as "Claimant Name"
				claimant_email as "Claimant Email"
				claim_description as "Claim Description"
				additional_details as "Additional Identification Details"
				claim_status as "Claim Status"
				admin_remarks as "Admin Remarks"
				submitted_date as "Submitted Date"
			)
			options
			(
	 			display field = claim_status
	 		)
		}
		list found_items_Report
		{
			displayName = "All Items"
			show all rows from found_items    
			(
				item_name as "Item Name"
				category as "Category"
				description as "Description"
				location_found as "Location Found"
				date_found as "Date Found"
				finder_name as "Finder Name"
				contact_email as "Contact Email"
				item_image as "Item Image"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Closed")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
			)
		}
		kanban found_items_by_category
		{
			displayName = "Categories"
			show all rows from found_items    
			(
				item_name as "Item Name"
				category as "Category"
				description as "Description"
				location_found as "Location Found"
				date_found as "Date Found"
				finder_name as "Finder Name"
				contact_email as "Contact Email"
				item_image as "Item Image"
				status as "Status"
			)
			options
			(
	 			display field = category
	 		)
		}
		list lost_items_Report
		{
			displayName = "All Items"
			show all rows from lost_items    
			(
				item_name as "Item Name"
				category as "Category"
				description as "Description"
				location_lost as "Location Lost"
				date_lost as "Date Lost"
				owner_name as "Owner Name"
				contact_email as "Contact Email"
				item_image as "Item Image"
				status as "Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Closed")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Open")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Returned")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban lost_items_by_category
		{
			displayName = "Categories"
			show all rows from lost_items    
			(
				item_name as "Item Name"
				category as "Category"
				description as "Description"
				location_lost as "Location Lost"
				date_lost as "Date Lost"
				owner_name as "Owner Name"
				contact_email as "Contact Email"
				item_image as "Item Image"
				status as "Status"
			)
			options
			(
	 			display field = category
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#F97164'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '20px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '64%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginTop = '8px'\n\tcolor = '#FFFFFF'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'claim_status == &quot;Approved&quot;'\n\t  value = 'thisapp.claim_requests.claim_status.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '8px' \n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\n\n\n\n\t  value = 'Count of Approved'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '36%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#C75A50'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'shopping-box'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n 