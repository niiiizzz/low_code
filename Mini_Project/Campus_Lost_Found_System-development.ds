		workflow
		{
		form
		{
			auto_set_lost_status as "Auto-set Lost Item Status"
			{
				type =  form
				form = lost_items

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set status to Open when a new lost item is created
										if(input.ID == null)
										{
											input.status = "Open";
										}
						)
					}
				}

			}
			validate_claim_reference as "Validate Claim Reference"
			{
				type =  form
				form = claim_requests

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate if item_reference field is present in the claim request
										if(input.item_reference.isNull())
										{
											// Display error message to user
											alert(item_reference,"Please select an item reference before submitting the claim.");
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			notify_admin_claim_approved as "Notify Admin on Claim Approval"
			{
				type =  form
				form = claim_requests

				record event = on edit

				on user input of claim_status
				{
					actions 
					{
						custom deluge script
						(
											// Check if claim_status field is set to Approved
										if(input.claim_status == "Approved")
										{
											// Fetch the claim request record to get claimant details
											claimRecord = claim_requests[ID == input.ID];
											// Prepare email subject and message
											subject = "Claim Request Approved";
											message = "Dear Admin,\n\n";
											message = message.concat("The claim request has been approved.\n\n");
											message = message.concat("Claimant: ").concat(claimRecord.claimant_name).concat("\n");
											message = message.concat("Email: ").concat(claimRecord.claimant_email).concat("\n\n");
											message = message.concat("Please review the details in the system.\n\n");
											message = message.concat("Thank you.");
											// Send email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :subject
												message :message
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			weekly_lost_items_reminder as "Weekly Lost Items Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all open lost items
										openLostItems = lost_items[status == "Open"];
										// Check if there are any open lost items
										if(openLostItems.count() > 0)
										{
											// Build email message
											emailBody = "<h2>Weekly Summary of Open Lost Items</h2>";
											emailBody = emailBody.concat("<p>Dear Lost Item Owners,</p>");
											emailBody = emailBody.concat("<p>Here is the summary of open lost items reported this week:</p>");
											emailBody = emailBody.concat("<table border='1' cellpadding='5' cellspacing='0'>");
											emailBody = emailBody.concat("<tr><th>Item Name</th><th>Category</th><th>Location Lost</th><th>Date Lost</th><th>Contact Email</th></tr>");
											for each  item in openLostItems
											{
												emailBody = emailBody.concat("<tr>");
												emailBody = emailBody.concat("<td>".concat(item.item_name).concat("</td>"));
												emailBody = emailBody.concat("<td>".concat(item.category).concat("</td>"));
												emailBody = emailBody.concat("<td>".concat(item.location_lost).concat("</td>"));
												// Format date if not null
												if(item.date_lost.isNull())
												{
													dateValue = "N/A";
												}
												else
												{
													dateValue = item.date_lost.toText("MMM dd, yyyy");
												}
												emailBody = emailBody.concat("<td>".concat(dateValue).concat("</td>"));
												emailBody = emailBody.concat("<td>".concat(item.contact_email).concat("</td>"));
												emailBody = emailBody.concat("</tr>");
											}
											emailBody = emailBody.concat("</table>");
											emailBody = emailBody.concat("<p>Please contact the respective owners if you find any of these items.</p>");
											// Send email to all owners
											ownerEmails = "";
											for each  item in openLostItems
											{
												if(ownerEmails.isEmpty())
												{
													ownerEmails = item.contact_email;
												}
												else
												{
													ownerEmails = ownerEmails.concat(",".concat(item.contact_email));
												}
											}
											sendmail
											[
												from :zoho.loginuserid
												to :ownerEmails
												subject :"Weekly Summary of Open Lost Items"
												message :emailBody
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


